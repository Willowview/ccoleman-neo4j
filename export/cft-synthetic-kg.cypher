:begin
CREATE FULLTEXT INDEX actor_fulltext FOR (n:Actor) ON EACH [n.`name`,n.`fullName`,n.`description`,n.`aliases`];
CREATE FULLTEXT INDEX capability_solution_fulltext FOR (n:CapabilitySolution) ON EACH [n.`name`,n.`description`,n.`aliases`];
CREATE FULLTEXT INDEX functional_capability_fulltext FOR (n:FunctionalCapability) ON EACH [n.`name`,n.`description`,n.`aliases`];
CREATE FULLTEXT INDEX objective_fulltext FOR (n:Objective) ON EACH [n.`name`,n.`description`,n.`aliases`];
CREATE FULLTEXT INDEX project_fulltext FOR (n:Project) ON EACH [n.`name`,n.`description`,n.`aliases`];
CREATE RANGE INDEX FOR (n:Actor) ON (n.name);
CREATE RANGE INDEX FOR (n:Actor) ON (n.type);
CREATE RANGE INDEX FOR (n:Actor) ON (n.validationStatus);
CREATE RANGE INDEX FOR (n:Artifact) ON (n.classification);
CREATE RANGE INDEX FOR (n:Artifact) ON (n.name);
CREATE RANGE INDEX FOR (n:CapabilitySolution) ON (n.fieldMaturityLevel);
CREATE RANGE INDEX FOR (n:CapabilitySolution) ON (n.mvcStatus);
CREATE RANGE INDEX FOR (n:CapabilitySolution) ON (n.name);
CREATE RANGE INDEX FOR (n:CapabilitySolution) ON (n.validationStatus);
CREATE RANGE INDEX FOR (n:FunctionalCapability) ON (n.name);
CREATE RANGE INDEX FOR (n:FunctionalCapability) ON (n.validationStatus);
CREATE RANGE INDEX FOR (n:Measure) ON (n.name);
CREATE RANGE INDEX FOR (n:Objective) ON (n.meLevel);
CREATE RANGE INDEX FOR (n:Objective) ON (n.name);
CREATE RANGE INDEX FOR (n:Project) ON (n.name);
CREATE RANGE INDEX FOR (n:Project) ON (n.projectType);
CREATE RANGE INDEX FOR (n:Project) ON (n.validationStatus);
CREATE CONSTRAINT actor_id_unique FOR (node:Actor) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT artifact_id_unique FOR (node:Artifact) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT capability_solution_id_unique FOR (node:CapabilitySolution) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT functional_capability_id_unique FOR (node:FunctionalCapability) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT measure_id_unique FOR (node:Measure) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT objective_id_unique FOR (node:Objective) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT project_id_unique FOR (node:Project) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT schema_migration_id_unique FOR (node:_SchemaMigration) REQUIRE (node.id) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
